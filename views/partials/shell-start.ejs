<%
    /* Shared page shell: sidebar + top bar. Pass { title, subtitle, active }.
       `currentUser` and `navCounts` come from res.locals (see app.js). */
    const u = (typeof currentUser !== "undefined" && currentUser) ? currentUser : { role: "hotel", name: "User" };
    const counts = (typeof navCounts !== "undefined" && navCounts) ? navCounts : {};
    const activeKey = typeof active !== "undefined" ? active : "";
    const pageTitle = typeof title !== "undefined" ? title : "SavoResQ";
    const pageSub = typeof subtitle !== "undefined" ? subtitle : "";

    const I = {
        home:    '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
        plus:    '<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>',
        list:    '<path d="M8 6h13M8 12h13M8 18h13"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/>',
        star:    '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
        award:   '<circle cx="12" cy="9" r="6"/><path d="m8.5 14.5-1.5 6 5-2.5 5 2.5-1.5-6"/>',
        user:    '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4.5-6.5 8-6.5s7 2 8 6.5"/>',
        settings:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
        logout:  '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/>',
        shield:  '<path d="M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
        users:   '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c2 .7 3.2 2.5 3.6 5.2"/>',
        edit:    '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
        trash:   '<path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/>',
        bell:    '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
        basket:  '<path d="M3 9h18l-2 11H5z"/><path d="m8 9 3-6M16 9l-3-6"/>',
        heart:   '<path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0L12 7l-1.4-1.4a5.2 5.2 0 0 0-7.4 7.4L12 21.8l8.8-8.8a5.2 5.2 0 0 0 0-7.4z"/>',
        menu:    '<path d="M4 6h16M4 12h16M4 18h16"/>',
        edit2:   '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"/>',
        chat:    '<path d="M4 5h16v11H9l-5 4z"/>',
        mail:    '<path d="M3 6h18v12H3z"/><path d="m3 7 9 7 9-7"/>',
        chart:   '<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>'
    };
    const ico = (n) => '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">' + I[n] + '</svg>';

    let nav = [];
    if (u.role === "hotel") {
        nav = [
            { sec: "Main" },
            { key: "dashboard", href: "/hotel",          icon: "home",  label: "Dashboard" },
            { key: "post",      href: "/hotel#post",     icon: "plus",  label: "Post Donation" },
            { key: "history",   href: "/hotel#history",  icon: "list",  label: "My Donations" },
            { key: "reviews",   href: "/hotel/feedback", icon: "star",  label: "NGO Reviews" },
            { key: "impact",    href: "/hotel/profile",  icon: "award", label: "Impact Profile" },
            { key: "chat",      href: "/chat",           icon: "mail",  label: "Messages", count: counts.chats },
            { key: "support",   href: "/support",        icon: "chat",  label: "Contact Admin", count: counts.supportReplies }
        ];
    } else if (u.role === "ngo") {
        nav = [
            { sec: "Main" },
            { key: "dashboard", href: "/ngo",           icon: "home",   label: "Dashboard" },
            { key: "available", href: "/ngo#available", icon: "basket", label: "Available Food" },
            { key: "history",   href: "/ngo#history",   icon: "heart",  label: "My Rescues" },
            { key: "feedback",  href: "/ngo/feedback",  icon: "star",   label: "Feedback", count: counts.feedbackPending },
            { key: "chat",      href: "/chat",          icon: "mail",   label: "Messages", count: counts.chats },
            { key: "support",   href: "/support",       icon: "chat",   label: "Contact Admin", count: counts.supportReplies }
        ];
    } else {
        nav = [
            { sec: "Administration" },
            { key: "dashboard",     href: "/admin",                icon: "chart",  label: "Dashboard" },
            { key: "verifications", href: "/admin/verifications",  icon: "shield", label: "Verifications", count: counts.pendingApprovals },
            { key: "users",         href: "/admin/users",          icon: "users",  label: "Users" },
            { key: "updates",       href: "/admin/profile-updates",icon: "edit2",  label: "Profile Updates", count: counts.profileUpdates },
            { key: "deletions",     href: "/admin/requests",       icon: "trash",  label: "Deletion Requests", count: counts.deletions },
            { key: "support",       href: "/admin/support",        icon: "chat",   label: "Support Requests", count: counts.support },
            { key: "feedback",      href: "/admin/feedback",       icon: "star",   label: "Feedback" }
        ];
    }

    const account = [{ sec: "Account" }];
    if (u.role !== "admin") {
        account.push({ key: "profile", href: "/account/profile/edit", icon: "user", label: "My Profile" });
    }
    account.push({ key: "settings", href: "/account/settings", icon: "settings", label: "Settings" });

    const roleLabel = u.role === "hotel" ? "Hotel Partner" : u.role === "ngo" ? "NGO Partner" : "Administrator";
    const displayName = u.orgName || u.name || "Account";
    const initials = String(displayName).trim().split(/\s+/).slice(0, 2).map(w => w[0]).join("").toUpperCase() || "S";
    const homeHref = u.role === "admin" ? "/admin" : "/" + u.role;

    const renderLink = (n) => n.sec
        ? '<div class="nav-label">' + n.sec + '</div>'
        : '<a class="nav-link' + (n.key === activeKey ? " active" : "") + '" href="' + n.href + '">' + ico(n.icon) +
          '<span>' + n.label + '</span>' + (n.count ? '<span class="nav-count">' + n.count + '</span>' : "") + '</a>';

    const notes = {
        hotel: ["Your surplus can feed someone today.", "Every donation reduces waste and supports your community."],
        ngo:   ["Every rescue makes a difference.", "Together we turn surplus food into hope."],
        admin: ["Keep the platform trusted.", "Verify organizations and keep rescues running smoothly."]
    }[u.role] || ["", ""];
%><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> · SavoResQ</title>
    <script>
    // Back/forward cache guard: if this page is restored from history, reload it so the server re-checks the login
    window.addEventListener("pageshow", function (e) {
        var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
        if (e.persisted || (nav && nav.type === "back_forward")) location.reload();
    });
    </script>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%B1%3C/text%3E%3C/svg%3E">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app">

    <aside class="sidebar" id="sidebar">
        <a class="brand" href="<%= homeHref %>">
            <div class="brand-mark"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15M5 19c2-5 5-8 9-10"/></svg></div>
            <div>
                <div class="brand-name">SavoResQ</div>
                <div class="brand-sub">Save Food • Feed People</div>
            </div>
        </a>

        <nav class="nav">
            <% nav.forEach(n => { %><%- renderLink(n) %><% }) %>
            <% account.forEach(n => { %><%- renderLink(n) %><% }) %>
        </nav>

        <div class="sidebar-note">
            <strong><%= notes[0] %></strong>
            <p><%= notes[1] %></p>
        </div>

        <div class="sidebar-bottom">
            <a class="nav-link logout" href="/logout"><%- ico("logout") %><span>Logout</span></a>
        </div>
    </aside>
    <div class="scrim" id="scrim"></div>

    <div class="main">
        <header class="topbar">
            <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu"><%- ico("menu") %></button>

            <div class="page-title">
                <h1><%= pageTitle %></h1>
                <% if (pageSub) { %><p><%= pageSub %></p><% } %>
            </div>

            <div class="top-right">
                <div class="notif-wrap" id="notifWrap">
                    <button class="icon-btn" id="bell" type="button" aria-label="Notifications"><%- ico("bell") %>
                        <span class="dot-count" id="bellCount" style="display:none">0</span>
                    </button>
                    <div class="notif-panel" id="notifPanel">
                        <div class="notif-head">
                            <strong>Notifications</strong>
                            <button type="button" id="markAll">Mark all read</button>
                        </div>
                        <div class="notif-list" id="notifList"><div class="notif-empty">Loading…</div></div>
                    </div>
                </div>

                <details class="user-menu" id="userMenu">
                    <summary>
                        <div class="user-chip">
                            <div class="avatar"><%= initials %></div>
                            <div class="who"><strong><%= displayName %></strong><span><%= roleLabel %></span></div>
                        </div>
                    </summary>
                    <div class="menu-panel">
                        <% if (u.role !== "admin") { %>
                            <a href="/account/profile/edit"><%- ico("user") %> My Profile</a>
                        <% } %>
                        <a href="/account/settings"><%- ico("settings") %> Settings</a>
                        <hr>
                        <a class="danger" href="/logout"><%- ico("logout") %> Logout</a>
                    </div>
                </details>
            </div>
        </header>

        <div class="page">
<% if (typeof flash !== "undefined" && flash) { %><div class="toast <%= flash.type === 'error' ? 'err' : '' %>"><%= flash.text %></div><% } %>

<%- include('partials/shell-start', { title: 'NGO Reviews', subtitle: 'Feedback from NGOs on the food you donated.', active: 'reviews' }) %>

<% const avg = Number(averageRating) || 0; const full = Math.round(avg); %>

<section class="stats">
    <div class="stat"><div class="stat-ico amber"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg></div><div><b><%= averageRating %> / 5</b><span>Food quality rating</span></div></div>
    <div class="stat"><div class="stat-ico blue"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg></div><div><b><%= feedbacks.length %></b><span>NGO review<%= feedbacks.length === 1 ? "" : "s" %></span></div></div>
</section>

<section class="card">
    <div class="section-head"><div><h2>Recent feedback</h2><p>Use it to keep improving every donation.</p></div></div>
    <% if (feedbacks.length === 0) { %>
        <div class="empty"><div class="big"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z"/><path d="m3 7 9 7 9-7"/></svg></div><strong>No feedback yet</strong>Reviews will appear here after your donations are rescued.</div>
    <% } else { %>
        <% feedbacks.forEach(item => { const r = Number(item.rating) || 0; %>
            <div class="review">
                <div class="review-media"><%- foodVisual(item.foodName, 30) %></div>
                <div style="flex:1">
                    <h4><%= item.foodName %> <span class="stars"><%= "★".repeat(r) %><i><%= "★".repeat(5 - r) %></i></span></h4>
                    <p><%= item.feedback %></p>
                    <small class="muted">From <strong><%= item.ngoId?.organizationName || item.ngoId?.name || "Verified NGO" %></strong> · <%= new Date(item.createdAt).toLocaleString() %></small>
                </div>
            </div>
        <% }) %>
    <% } %>
</section>

<%- include('partials/shell-end') %>

<%- include('partials/shell-start', { title: 'My Profile', subtitle: 'Your organization details. Changes are reviewed by the admin before going live.', active: 'profile' }) %>

<%
    const labels = { name: "Contact Person", phone: "Phone", organizationName: "Organization", registrationNumber: "Registration No.", address: "Address", city: "City", state: "State", country: "Country", pincode: "Pincode" };
    const approved = user.approvalStatus === "Approved";
    const locked = user.accountStatus === "Deletion Requested" || user.accountStatus === "Deleted";
%>

<section class="hero">
    <div class="profile-hero">
        <div class="avatar"><%= user.role === "hotel" ? "" : "" %></div>
        <div>
            <h2 style="margin-bottom:4px"><%= user.organizationName || user.name %></h2>
            <p><%= [user.city, user.state].filter(Boolean).join(", ") %> · PIN <%= user.pincode %> · <%= user.role === "hotel" ? "Hotel" : "NGO" %> account</p>
            <div class="hero-actions" style="margin-top:12px">
                <span class="badge <%= approved ? 'approved' : user.approvalStatus === 'Rejected' ? 'rejected' : 'pending' %>"><%= approved ? "✓ Verified" : user.approvalStatus %></span>
                <span class="badge <%= user.accountStatus === 'Active' ? 'active' : 'pending' %>"><%= user.accountStatus %></span>
            </div>
        </div>
    </div>
</section>

<% if (pendingProfileUpdate) { %>
    <section class="card">
        <div class="card-head"><div class="stat-ico amber"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><h2>Update waiting for admin review</h2></div>
        <p class="card-sub">Submitted <%= new Date(pendingProfileUpdate.createdAt).toLocaleString() %>. You can submit another request once this one is reviewed.</p>
        <div class="diff">
            <div class="h">Field</div><div class="h">Current</div><div class="h">Requested</div>
            <% pendingProfileUpdate.changedFields.forEach(f => { %>
                <div><strong><%= labels[f] || f %></strong></div>
                <div class="old"><%= pendingProfileUpdate.currentData[f] || "—" %></div>
                <div class="new"><%= pendingProfileUpdate.requestedData[f] || "—" %></div>
            <% }) %>
        </div>
    </section>
<% } else if (locked) { %>
    <div class="hint-box warn">This account is awaiting a deletion decision, so the profile can’t be edited right now.</div>
<% } else { %>
    <section class="card">
        <div class="card-head"><div class="stat-ico"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div><h2>Edit organization details</h2></div>
        <p class="card-sub">Changes are sent to the admin for approval and take effect once approved.</p>

        <form action="/account/profile/update-request" method="POST" onsubmit="return confirm('Submit these changes for admin review?')">
            <div class="form-grid">
                <div class="field"><label for="name">Contact Person</label><input id="name" name="name" value="<%= user.name || '' %>" maxlength="100" required></div>
                <div class="field"><label for="phone">Phone Number</label><input id="phone" name="phone" type="tel" value="<%= user.phone || '' %>" maxlength="20" required></div>
                <div class="field"><label for="organizationName">Organization Name</label><input id="organizationName" name="organizationName" value="<%= user.organizationName || '' %>" maxlength="150" required></div>
                <div class="field"><label for="registrationNumber">Registration Number</label><input id="registrationNumber" name="registrationNumber" value="<%= user.registrationNumber || '' %>" maxlength="100" required></div>
                <div class="field full"><label for="address">Address</label><input id="address" name="address" value="<%= user.address || '' %>" maxlength="250" required></div>
                <div class="field"><label for="city">City</label><input id="city" name="city" value="<%= user.city || '' %>" maxlength="100" required></div>
                <div class="field"><label for="state">State</label><input id="state" name="state" value="<%= user.state || '' %>" maxlength="100" required></div>
                <div class="field"><label for="country">Country</label><input id="country" name="country" value="<%= user.country || 'India' %>" maxlength="100" required></div>
                <div class="field">
                    <label for="pincode">Pincode</label>
                    <input id="pincode" name="pincode" value="<%= user.pincode || '' %>" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" required>
                    <span class="help">Changing it changes which donations you can post or see.</span>
                </div>
            </div>
            <div class="hint-box"> Email, role, password and verification status can’t be changed here.</div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Submit for Review</button>
                <a class="btn btn-outline" href="<%= user.role === 'hotel' ? '/hotel' : '/ngo' %>">Cancel</a>
            </div>
        </form>
    </section>
<% } %>

<section class="card">
    <div class="card-head"><div class="stat-ico slate"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></div><h2>Protected account info</h2></div>
    <div class="kv" style="margin-top:12px">
        <div><small>Email</small><strong><%= user.email %></strong></div>
        <div><small>Account type</small><strong><%= user.role.toUpperCase() %></strong></div>
        <div><small>Member since</small><strong><%= new Date(user.createdAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }) %></strong></div>
    </div>
</section>

<%- include('partials/shell-end') %>

<%- include('partials/shell-start', { title: 'Feedback & Ratings', subtitle: 'Tell hotels how the rescued food turned out.', active: 'feedback' }) %>

<%
    const pending   = pendingFeedbacks || [];
    const submitted = myFeedbacks || [];
    const avgGiven  = submitted.length ? (submitted.reduce((s, f) => s + Number(f.rating), 0) / submitted.length).toFixed(1) : "–";
    const hotelName = (h) => (h && (h.organizationName || h.name)) || "Hotel";
%>

<section class="stats">
    <div class="stat"><div class="stat-ico amber"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div><div><b><%= pending.length %></b><span>Waiting for feedback</span></div></div>
    <div class="stat"><div class="stat-ico blue"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg></div><div><b><%= submitted.length %></b><span>Submitted</span></div></div>
    <div class="stat"><div class="stat-ico"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg></div><div><b><%= avgGiven %><%= submitted.length ? " / 5" : "" %></b><span>Your average rating</span></div></div>
</section>

<% const working = typeof inProgress !== "undefined" ? inProgress : []; %>

<% if (working.length) { %>
    <section class="card" style="margin-bottom:26px">
        <div class="section-head" style="margin-bottom:10px">
            <div><h2> Step 1 — Mark your rescue as done</h2><p>Feedback opens as soon as you mark a food donation as rescued.</p></div>
        </div>
        <% working.forEach(d => { %>
            <div class="review" style="align-items:center">
                <div class="review-media"><%- foodVisual(d.foodName, 30, d.image) %></div>
                <div style="flex:1"><h4><%= d.foodName %></h4><span class="muted small"> <%= hotelName(d.hotelId) %> · <%= d.quantity %> portions</span></div>
                <form class="inline-form" action="/ngo/donation/<%= d._id %>/complete" method="POST" onsubmit="return confirm('Mark this donation as successfully rescued?')">
                    <input type="hidden" name="next" value="feedback">
                    <button class="btn btn-primary btn-sm" type="submit"> Mark as rescued</button>
                </form>
            </div>
        <% }) %>
    </section>
<% } %>

<section>
    <div class="section-head"><div><h2><%= working.length ? "Step 2 — " : "" %>Rate your rescues</h2><p>Honest ratings help hotels improve and help other NGOs know what to expect.</p></div></div>

    <% if (pending.length === 0) { %>
        <div class="empty">
            <div class="big"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div>
            <strong>No feedback form yet</strong>
            The feedback box (star rating + text) appears here for every food donation you have <b>rescued</b>.<br>
            How it works: <b>Accept</b> a donation → collect it → press <b>Mark as rescued</b> → rate it here.
            <div style="margin-top:14px"><a class="btn btn-outline btn-sm" href="/ngo#available">See available food</a></div>
        </div>
    <% } else { %>
        <% pending.forEach(d => { %>
            <article class="card rescue" style="margin-bottom:18px">
                <div class="rescue-media"><%- foodVisual(d.foodName, 64, d.image) %></div>
                <div>
                    <h3 style="font-size:19px"><%= d.foodName %></h3>
                    <div class="meta-line" style="margin:4px 0 12px;flex-wrap:wrap">
                        <span> <strong><%= hotelName(d.hotelId) %></strong></span>
                        <span>·  <strong><%= d.quantity %></strong> portions</span>
                        <span>·  <%= d.pincode %></span>
                    </div>
                    <form action="/ngo/feedback/<%= d._id %>" method="POST" class="rate-form">
                        <strong class="small">How was the food?</strong><br>
                        <div class="stars-input">
                            <% for (let i = 5; i >= 1; i--) { %>
                                <input type="radio" id="s-<%= d._id %>-<%= i %>" name="rating" value="<%= i %>" required>
                                <label for="s-<%= d._id %>-<%= i %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>">★</label>
                            <% } %>
                        </div>
                        <div class="chips">
                            <button type="button" class="chip" data-text="Food was fresh and well packed."> Fresh</button>
                            <button type="button" class="chip" data-text="Quantity matched what was posted."> Right quantity</button>
                            <button type="button" class="chip" data-text="Pickup was smooth and the staff were helpful."> Easy pickup</button>
                            <button type="button" class="chip" data-text="Packaging could be improved."> Better packaging</button>
                        </div>
                        <div class="field">
                            <textarea name="feedback" rows="3" minlength="3" maxlength="1000" placeholder="Describe freshness, quantity, packaging and pickup…" required></textarea>
                        </div>
                        <div class="form-actions"><button class="btn btn-primary btn-sm" type="submit">Submit feedback</button></div>
                    </form>
                </div>
            </article>
        <% }) %>
    <% } %>
</section>

<section class="card">
    <div class="section-head"><div><h2>My submitted feedback</h2></div></div>
    <% if (submitted.length === 0) { %>
        <div class="empty"><div class="big"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z"/><path d="m3 7 9 7 9-7"/></svg></div><strong>Nothing submitted yet</strong>Your reviews will appear here.</div>
    <% } else { %>
        <% submitted.forEach(item => { const r = Math.max(0, Math.min(5, Number(item.rating) || 0)); %>
            <div class="review">
                <div class="review-media"><%- foodVisual(item.foodName, 30) %></div>
                <div style="flex:1">
                    <h4><%= item.foodName %> <span class="stars"><%= "★".repeat(r) %><i><%= "★".repeat(5 - r) %></i></span></h4>
                    <div class="muted small"> <%= hotelName(item.hotelId) %></div>
                    <p><%= item.feedback %></p>
                    <small class="muted"><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "" %></small>
                </div>
            </div>
        <% }) %>
    <% } %>
</section>

<script>
document.querySelectorAll(".rate-form").forEach(function (form) {
    var box = form.querySelector("textarea");
    form.querySelectorAll(".chip").forEach(function (chip) {
        chip.addEventListener("click", function () {
            var add = chip.dataset.text;
            if (box.value.includes(add)) return;
            box.value = (box.value.trim() ? box.value.trim() + " " : "") + add;
            box.focus();
        });
    });
});
</script>

<%- include('partials/shell-end') %>

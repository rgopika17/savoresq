<%- include('partials/shell-start', { title: 'Verification Document', subtitle: (org.organizationName || org.name), active: 'verifications' }) %>

<section class="card">
    <div class="section-head">
        <div>
            <h2> <%= doc.filename || "Submitted document" %></h2>
            <p><%= org.organizationName || org.name %> · <%= org.role.toUpperCase() %></p>
        </div>
        <div class="row-actions">
            <a class="btn btn-primary btn-sm" href="<%= backUrl %>">← Back to details</a>
            <a class="btn btn-outline btn-sm" href="/admin/verification-document/<%= org._id %>?download=1">⬇ Download</a>
            <a class="btn btn-outline btn-sm" target="_blank" rel="noopener" href="/admin/verification-document/<%= org._id %>">Open full size ↗</a>
        </div>
    </div>

    <div class="doc-frame">
        <% if (isPdf) { %>
            <iframe src="/admin/verification-document/<%= org._id %>" title="Verification document"></iframe>
        <% } else { %>
            <img src="/admin/verification-document/<%= org._id %>" alt="Verification document of <%= org.organizationName || org.name %>">
        <% } %>
    </div>
</section>

<%- include('partials/shell-end') %>
